    CFG -- "설치 · 설정 배포<br/>Semaphore + Ansible" --> TEL

    subgraph VM ["GPU VM - passthrough · vGPU · MIG guest"]
        DRV{{NVIDIA driver<br/>nvidia-smi · NVML}}
